@model OrderModel
@{
	ViewBag.Title = "CheckOut";
}
<html>
<head>
	<title>Payment Page</title>
</head>
<body>
	<form method="post" asp-action="CheckOut">
		<div>
			<div class="container pb-5">
				<h2>Card Information</h2>
				<div class="mb-2">
					<label asp-for="@Model.CardNumber" class="form-label">Card Number</label>
					<input asp-for="@Model.CardNumber" class="form-control" name="model.CardNumber" />
					<span asp-validation-for="@Model.CardNumber" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.ExpirationMonth" class="form-label">Card Month</label>
					<input asp-for="@Model.ExpirationMonth" class="form-control" name="model.ExpirationMonth" />
					<span asp-validation-for="@Model.ExpirationMonth" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.ExpirationYear" class="form-label">Card Year</label>
					<input asp-for="@Model.ExpirationYear" class="form-control" name="model.ExpirationYear" />
					<span asp-validation-for="@Model.ExpirationYear" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.SecurityCode" class="form-label">Security Code</label>
					<input asp-for="@Model.SecurityCode" class="form-control" name="model.SecurityCode" />
					<span asp-validation-for="@Model.SecurityCode" class="text-danger"></span>
				</div>
			</div>
			<div class="container pb-5">
				<h2>Bill Information</h2>

				<div class="mb-2">
					<label asp-for="@Model.Name" class="form-label">Name</label>
					<input asp-for="@Model.Name" class="form-control" name="model.Name" type="text" />
					<span asp-validation-for="@Model.Name" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.Surname" class="form-label">Surname</label>
					<input asp-for="@Model.Surname" class="form-control" name="model.Surname" type="text" />
					<span asp-validation-for="@Model.Surname" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.City" class="form-label">City</label>
					<input asp-for="@Model.City" class="form-control" name="model.City" type="text" />
					<span asp-validation-for="@Model.City" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.PostCode" class="form-label">PostCode</label>
					<input asp-for="@Model.PostCode" class="form-control" name="model.PostCode" />
					<span asp-validation-for="@Model.PostCode" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.Address" class="form-label">Address</label>
					<textarea asp-for="@Model.Address" class="form-control" name="model.Address"></textarea>
					<span asp-validation-for="@Model.Address" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.Country" class="form-label">Country</label>
					<input asp-for="@Model.Country" class="form-control" name="model.Country" type="text" />
					<span asp-validation-for="Country" class="text-danger"></span>
				</div>
				<div class="mb-2">
					<label asp-for="@Model.PhoneNo" class="form-label">Phone Number</label>
					<input asp-for="@Model.PhoneNo" class="form-control" name="model.PhoneNo" />
					<span asp-validation-for="@Model.PhoneNo" class="text-danger"></span>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-offset-2 col-md-10">
					<button type="submit" asp-action="PaymentFinalPage" class="btn btn-primary">Create Payment</button>
				</div>
			</div>
		</div>
	</form>
	<div>
		<h4>Order Summary</h4>
		<ul class="list-group" mb-3>
			@foreach(var item in Model.PaymentList.Items)
			{
				
				<li>
					<div>					
						<h6>@item.Game.GameName</h6>
					</div>
					<span>@item.Game.GamePrice</span>
				</li>
				<li>
					<span>Total Price :</span>
					<strong>@Model.PaymentList.Total()</strong>
				</li>
				

			}

		</ul>

	</div>
</body>
</html>