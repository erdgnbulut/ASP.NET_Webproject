@model Role

<head>
    <link rel="stylesheet" href="~/lib/css/CreateUser.css" />
</head>
<h2>Edit Role</h2>
<hr>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input name="Id" type="hidden" value="@Model.Id">
    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control">
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

<hr>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th> </th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.Users != null)
        {
            @if (ViewBag.Users.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center">No User</td>
                </tr>
            }
            @foreach (var user in ViewBag.Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>
                        <a asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary btn-sm">Edit</a>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure?')"
                            style="display: inline;">
                            <input type="hidden" value="@user.Id" name="id">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>